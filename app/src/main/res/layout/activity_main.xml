<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="24dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="4dp"
            android:text="@string/app_name"
            android:textColor="@color/text_primary"
            android:textSize="32sp" />

        <TextView
            style="@style/Body"
            android:layout_marginTop="4dp"
            android:paddingHorizontal="4dp"
            android:text="@string/intro" />

        <!-- Hero: mode selector and live state -->
        <LinearLayout
            style="@style/Card"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_hero"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tile_label"
                android:textColor="@color/on_primary_container"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/on_primary_container"
                android:textSize="28sp" />

            <RadioGroup
                android:id="@+id/mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_segment_group"
                android:orientation="horizontal"
                android:padding="4dp">

                <RadioButton
                    android:id="@+id/mode_off"
                    style="@style/Segment"
                    android:text="@string/mode_off" />

                <RadioButton
                    android:id="@+id/mode_on"
                    style="@style/Segment"
                    android:text="@string/mode_on" />
            </RadioGroup>

            <TextView
                android:id="@+id/mode_desc"
                style="@style/Body"
                android:layout_marginTop="12dp"
                android:textColor="@color/on_primary_container" />

            <CheckBox
                android:id="@+id/auto_stop"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:buttonTint="@color/on_primary_container"
                android:minHeight="48dp"
                android:text="@string/auto_stop"
                android:textColor="@color/on_primary_container" />

            <TextView
                android:id="@+id/auto_stop_hint"
                style="@style/Body"
                android:layout_marginStart="32dp"
                android:text="@string/auto_stop_hint"
                android:textColor="@color/on_primary_container"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/overlay_hint"
                style="@style/Body"
                android:layout_marginTop="12dp"
                android:text="@string/overlay_hint"
                android:textColor="@color/on_primary_container" />

            <Button
                android:id="@+id/grant_overlay"
                style="@style/FilledButton"
                android:layout_marginTop="12dp"
                android:text="@string/grant_overlay" />
        </LinearLayout>

        <!-- Vehicle detection diagnostics (while "turn off when I leave the vehicle" is enabled) -->
        <LinearLayout
            android:id="@+id/detection_card"
            style="@style/Card">

            <TextView
                style="@style/SectionTitle"
                android:text="@string/detection_title" />

            <TextView
                android:id="@+id/detection_log"
                style="@style/Body"
                android:layout_marginTop="8dp"
                android:fontFamily="monospace"
                android:textIsSelectable="true"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/detection_copy"
                    style="@style/TextButton"
                    android:text="@string/detection_copy" />

                <Button
                    android:id="@+id/detection_clear"
                    style="@style/TextButton"
                    android:text="@string/detection_clear" />
            </LinearLayout>
        </LinearLayout>

        <!-- Appearance -->
        <LinearLayout style="@style/Card">

            <TextView
                style="@style/SectionTitle"
                android:text="@string/section_appearance" />

            <FrameLayout
                android:id="@+id/preview"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_preview"
                android:clipToOutline="true" />

            <TextView
                style="@style/Body"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="@string/preview_caption"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/sliders"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <CheckBox
                android:id="@+id/top_bottom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:buttonTint="@color/primary"
                android:minHeight="48dp"
                android:text="@string/top_bottom_dots" />

            <TextView
                style="@style/Body"
                android:layout_marginTop="12dp"
                android:text="@string/dot_color"
                android:textColor="@color/text_primary" />

            <RadioGroup
                android:id="@+id/color"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp">

                <RadioButton android:id="@+id/color_auto" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:minHeight="44dp"
                    android:buttonTint="@color/primary" android:text="@string/color_auto" />
                <RadioButton android:id="@+id/color_white" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:minHeight="44dp"
                    android:buttonTint="@color/primary" android:text="@string/color_white" />
                <RadioButton android:id="@+id/color_black" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:minHeight="44dp"
                    android:buttonTint="@color/primary" android:text="@string/color_black" />
                <RadioButton android:id="@+id/color_blue" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:minHeight="44dp"
                    android:buttonTint="@color/primary" android:text="@string/color_blue" />
            </RadioGroup>
        </LinearLayout>

        <!-- Ride rating (MISC) -->
        <LinearLayout style="@style/Card">

            <TextView
                style="@style/SectionTitle"
                android:text="@string/section_misc" />

            <TextView
                android:id="@+id/misc_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/text_primary"
                android:textSize="36sp" />

            <TextView
                android:id="@+id/misc_label"
                style="@style/Body" />

            <SeekBar
                android:id="@+id/misc"
                style="@style/Slider"
                android:layout_marginTop="8dp"
                android:max="10" />

            <CheckBox
                android:id="@+id/misc_dots_on"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="@color/primary"
                android:minHeight="48dp"
                android:text="@string/misc_dots_on" />

            <Button
                android:id="@+id/misc_save"
                style="@style/FilledButton"
                android:layout_marginTop="4dp"
                android:text="@string/misc_save" />

            <TextView
                android:id="@+id/misc_summary"
                style="@style/Body"
                android:layout_marginTop="12dp" />

            <LinearLayout
                android:id="@+id/history_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical">

                <TextView
                    style="@style/SectionTitle"
                    android:text="@string/history" />

                <LinearLayout
                    android:id="@+id/history"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="vertical" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/history_toggle"
                        style="@style/TextButton" />

                    <Button
                        android:id="@+id/history_clear"
                        style="@style/TextButton"
                        android:text="@string/history_clear" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Other settings -->
        <LinearLayout style="@style/Card">

            <TextView
                style="@style/SectionTitle"
                android:text="@string/section_other" />

            <CheckBox
                android:id="@+id/show_notification"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:buttonTint="@color/primary"
                android:minHeight="48dp"
                android:text="@string/show_notification" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
